<!DOCTYPE html>
<html lang="en">
<head>
  {{> head}}
</head>
<body>
  <article>
    <nav class="site-nav">
      {{> topnav}}
    </nav>
    <h1>{{title}}</h1>
    <section>
      {{{contents}}}
    </section>
    <ul class="post-list">
      {{#each collections.posts}}
      <li><a href="{{../site.base}}{{url}}">{{title}}</a><span class="date">{{dateLabel}}</span></li>
      {{/each}}
    </ul>
    <section><p class="site-footer">&copy; {{site.author}}. Set in <a href="https://github.com/edwardtufte/tufte-css">Tufte CSS</a>.</p></section>
  </article>
</body>
</html>
