<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · {{site.title}}</title>
  <link rel="stylesheet" href="{{site.base}}/css/tufte.css">
  <link rel="stylesheet" href="{{site.base}}/css/site.css">
</head>
<body>
  <article>
    <nav class="site-nav">
      <a href="{{site.base}}/">{{site.title}}</a>
      <a href="{{site.base}}/forgive-me-nots/">The Forgive-me-nots</a>
      <a href="{{site.base}}/posts/">Posts/Events</a>
      <a href="{{site.base}}/about/">About</a>
    </nav>
    <h1>{{title}}</h1>
    {{{contents}}}
    <ul class="post-list">
      {{#each collections.posts}}
      <li><a href="{{../site.base}}{{url}}">{{title}}</a><span class="date">{{dateLabel}}</span></li>
      {{/each}}
    </ul>
    <section><p class="site-footer">&copy; {{site.author}}. Set in <a href="https://github.com/edwardtufte/tufte-css">Tufte CSS</a>.</p></section>
  </article>
</body>
</html>
